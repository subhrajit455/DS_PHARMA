# Environment Variables for DS Pharma Frontend

# API Base URL
# For local development, use your local backend server
# For production, use your deployed backend URL
VITE_API_BASE_URL=http://localhost:3000/api

# Example values for different environments:
# Development: http://localhost:3000/api
# Staging: https://staging-api.dspharma.com/api
# Production: https://api.dspharma.com/api
